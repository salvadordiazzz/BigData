# raw data (too large for git)
/data/data_raw
/data/filtered_data
/data/processed/*.parquet

# generated outputs (reproducible from scripts)
src/*/outputs/
!src/*/outputs/.gitkeep

# python cache
__pycache__/
*.pyc
*.pyo

# archive folder (one-time or legacy files)
/archive/

# deliverables: generated reports + slides + builder scripts
# (kept locally for grading; not part of the technical pipeline)
/deliverables/

# reports/ is tracked in git: curated figures, metric summaries, and plans
# (no exclusions needed — everything under reports/ is committed)
